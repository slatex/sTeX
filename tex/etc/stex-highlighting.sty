%\RequirePackage{xcolor}
\RequirePackage{pdfcomment}
\RequirePackage{l3keys2e}
\ExplSyntaxOn

\keys_define:nn { stexhighlighting / pkg}{
  boxes   .default:n = {true},
  boxes   .bool_set:N = \c_stexhighlighting_boxes_bool,
}

\ProcessKeysOptions{ stexhighlighting / pkg}

\AtBeginDocument{
  \cs_if_exist:cTF{textcolor}{
    \def\stex_highlighting_compemph:n#1{
      \textcolor{teal}{#1}
    }
    \def\stex_highlighting_symrefemph:n#1{
      \textcolor{teal}{#1}
    }
    \def\stex_highlighting_defemph:n#1{
      \textcolor{magenta}{
        \ifmmode\else
          \expandafter\textbf
        \fi
        {#1}
      }
    }
    \def\stex_highlighting_varemph:n#1{
      \textcolor{gray}{#1}
    }
  }{
    \def\stex_highlighting_compemph:n#1{#1}
    \def\stex_highlighting_symrefemph:n#1{#1}
    \def\stex_highlighting_defemph:n#1{
      \ifmmode\else
        \expandafter\textbf
      \fi
      {#1}
    }
    \def\stex_highlighting_varemph:n#1{#1}
  }
}

\def\stexactivatehighlighting{
  \def\compemph{\stex_highlighting_compemph:n}
  \def\symrefemph{\stex_highlighting_symrefemph:n}
  \def\defemph{\stex_highlighting_defemph:n}
  \def\varemph{\stex_highlighting_varemph:n}
}
\def\stexdeactivatehighlighting{
  \def\compemph{}
  \def\symrefemph{}
  \def\defemph{\ifmmode\else\expandafter\textbf\fi}
  \def\varemph{}
}
\stexactivatehighlighting


\bool_if:NTF\c_stexhighlighting_boxes_bool{
  \protected\def\compemph@uri#1#2{
    \pdftooltip{
      \srefsymuri{#2}{\compemph{#1}}
    }{
      URI:~#2
    }
  }
  \protected\def\symrefemph@uri#1#2{
    \pdftooltip{
      \srefsymuri{#2}{\symrefemph{#1}}
    }{
      URI:~#2
    }
  }
}{
  \protected\def\compemph@uri#1#2{
    \pdftooltip{{\hypersetup{pdfborder={0~0~0}}
      \srefsymuri{#2}{\compemph{#1}}
    }}{
      URI:~#2
    }
  }
  \protected\def\symrefemph@uri#1#2{
    \pdftooltip{{\hypersetup{pdfborder={0~0~0}}
      \srefsymuri{#2}{\symrefemph{#1}}
    }}{
      URI:~#2
    }
  }
}

\protected\def\defemph@uri#1#2{%
   \pdftooltip{%
     \defemph{#1}%
   }{%
     URI:~#2%
   }%
}
\protected\def\varemph@uri#1#2{%
   \pdftooltip{%
     \varemph{#1}%
   }{%
     Variable~#2%
   }%
}



\ExplSyntaxOff
% and get rid of the ugly boxes
\hypersetup{hidelinks}

